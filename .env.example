# Copie este arquivo para `.env` e preencha com os valores reais.
# Nada aqui vai pro git — o .env real fica fora do versionamento.

# Porta do servidor HTTP
PORT=3000

# Conexão MongoDB (Atlas ou local)
MONGODB_URI=mongodb://localhost:27017/quebra-tigela

# JWT — gere um segredo forte (ex: openssl rand -hex 32)
JWT_SECRET=troque-isto-por-um-segredo-aleatorio-longo
JWT_EXPIRES=7d

# SMTP — usado pra enviar e-mail de redefinição de senha.
# Recomendado: Brevo (https://brevo.com), Resend, Mailgun, etc.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-login-smtp
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM="Quebra Tigela <nao-responda@seudominio.com>"
